#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
remote_name="$1"
remote_url="$2"
expected_remote="git@github.com:DanielMulec/dm_voicelint.git"
expected_ref="refs/heads/main"
validator="$repo_root/.githooks/validate-commit-message"

if [ "$remote_name" != "origin" ]; then
  echo "dm_voicelint policy: pushes are only allowed to origin" >&2
  exit 1
fi

if [ "$remote_url" != "$expected_remote" ]; then
  echo "dm_voicelint policy: unexpected push remote $remote_url" >&2
  exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha
do
  [ -z "${local_ref:-}" ] && continue
  if [ "$local_ref" != "$expected_ref" ] || [ "$remote_ref" != "$expected_ref" ]; then
    echo "dm_voicelint policy: only main -> main pushes are allowed" >&2
    echo "blocked: $local_ref -> $remote_ref" >&2
    exit 1
  fi

  commit_range="$remote_sha..$local_sha"
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    commit_range="$local_sha"
  fi

  for commit_sha in $(git rev-list --reverse "$commit_range")
  do
    message_file="$(mktemp)"
    files_file="$(mktemp)"

    cleanup() {
      rm -f "$message_file" "$files_file"
    }

    trap cleanup EXIT INT TERM HUP

    git log -1 --format=%B "$commit_sha" > "$message_file"
    git diff-tree --root --no-commit-id --name-only --no-renames -r "$commit_sha" > "$files_file"

    "$validator" \
      "$message_file" \
      "$files_file" \
      "commit $commit_sha in push to origin/main"

    rm -f "$message_file" "$files_file"
    trap - EXIT INT TERM HUP
  done
done
