#!/bin/sh
set -eu

message_file="$1"
expected_files_file="$2"
context_label="${3:-commit message}"
repo_root="$(git rev-parse --show-toplevel)"
expected_implemented_with="$("$repo_root/.githooks/read-implemented-with" || true)"

clean_message_file="$(mktemp)"
actual_files_file="$(mktemp)"
expected_sorted_file="$(mktemp)"
actual_sorted_file="$(mktemp)"

cleanup() {
  rm -f \
    "$clean_message_file" \
    "$actual_files_file" \
    "$expected_sorted_file" \
    "$actual_sorted_file"
}

trap cleanup EXIT INT TERM HUP

fail() {
  echo "dm_voicelint policy: invalid $context_label" >&2
  echo "$1" >&2
  exit 1
}

is_placeholder_line() {
  case "$1" in
    "describe what changed" | \
    "explain why this change is needed" | \
    "describe the implementation" | \
    "list every changed file in this commit" | \
    TODO* | todo* | TBD* | tbd* | \
    "<"*">")
      return 0
      ;;
  esac

  return 1
}

sed '/^[[:space:]]*#/d;s/\r$//' "$message_file" > "$clean_message_file"

subject_line="$(sed -n '/./{p;q;}' "$clean_message_file")"
[ -n "$subject_line" ] || fail "subject line is required"

subject_seen=0
state="await_what"
what_count=0
why_count=0
how_count=0
files_count=0
implemented_with_seen=0

while IFS= read -r line || [ -n "$line" ]
do
  if [ "$subject_seen" -eq 0 ]; then
    if [ -z "$line" ]; then
      continue
    fi

    subject_seen=1
    continue
  fi

  if [ -z "$line" ]; then
    if [ "$state" = "after_files" ] || [ "$state" = "in_files" ] || [ "$state" = "after_files_blank" ]; then
      state="after_files_blank"
    fi

    continue
  fi

  case "$line" in
    What:)
      [ "$state" = "await_what" ] || fail "What: must come before Why:, How:, Files:, and Implemented with"
      state="in_what"
      continue
      ;;
    Why:)
      [ "$what_count" -gt 0 ] || fail "Why: requires at least one What bullet first"
      [ "$state" = "after_what" ] || [ "$state" = "in_what" ] || fail "Why: must come after the What section"
      state="in_why"
      continue
      ;;
    How:)
      [ "$why_count" -gt 0 ] || fail "How: requires at least one Why bullet first"
      [ "$state" = "after_why" ] || [ "$state" = "in_why" ] || fail "How: must come after the Why section"
      state="in_how"
      continue
      ;;
    Files:)
      [ "$how_count" -gt 0 ] || fail "Files: requires at least one How bullet first"
      [ "$state" = "after_how" ] || [ "$state" = "in_how" ] || fail "Files: must come after the How section"
      state="in_files"
      continue
      ;;
    Implemented\ with\ *)
      implemented_with_value="${line#Implemented with }"
      [ -n "$implemented_with_value" ] || fail "Implemented with requires a non-empty value"
      is_placeholder_line "$implemented_with_value" && fail "replace the Implemented with placeholder before committing"
      if [ -n "$expected_implemented_with" ] && [ "$implemented_with_value" != "$expected_implemented_with" ]; then
        fail "Implemented with must be \"$expected_implemented_with\" for this Codex session"
      fi
      [ "$files_count" -gt 0 ] || fail "Implemented with requires at least one Files bullet first"
      [ "$state" = "after_files_blank" ] || fail "Implemented with must be separated from Files by a blank line"
      [ "$implemented_with_seen" -eq 0 ] || fail "Implemented with may only appear once"
      implemented_with_seen=1
      state="after_implemented_with"
      continue
      ;;
    -\ *)
      bullet_text="${line#- }"
      is_placeholder_line "$bullet_text" && fail "replace template placeholder bullets before committing"

      case "$state" in
        in_what | after_what)
          what_count=$((what_count + 1))
          state="after_what"
          ;;
        in_why | after_why)
          why_count=$((why_count + 1))
          state="after_why"
          ;;
        in_how | after_how)
          how_count=$((how_count + 1))
          state="after_how"
          ;;
        in_files | after_files)
          files_count=$((files_count + 1))
          state="after_files"
          printf '%s\n' "$bullet_text" >> "$actual_files_file"
          ;;
        *)
          fail "bullets are only allowed inside What, Why, How, or Files sections"
          ;;
      esac
      continue
      ;;
    *)
      fail "unexpected line: $line"
      ;;
  esac
done < "$clean_message_file"

[ "$what_count" -gt 0 ] || fail "What: must contain at least one bullet"
[ "$why_count" -gt 0 ] || fail "Why: must contain at least one bullet"
[ "$how_count" -gt 0 ] || fail "How: must contain at least one bullet"
[ "$files_count" -gt 0 ] || fail "Files: must contain at least one bullet"
[ "$implemented_with_seen" -eq 1 ] || fail "Implemented with must appear exactly once"

LC_ALL=C sort -u "$expected_files_file" | sed '/^[[:space:]]*$/d' > "$expected_sorted_file"
LC_ALL=C sort -u "$actual_files_file" | sed '/^[[:space:]]*$/d' > "$actual_sorted_file"

if ! cmp -s "$expected_sorted_file" "$actual_sorted_file"; then
  echo "dm_voicelint policy: invalid $context_label" >&2
  echo "Files: must list every changed file in this commit exactly once" >&2
  echo "expected files:" >&2
  sed 's/^/- /' "$expected_sorted_file" >&2
  echo "listed files:" >&2
  sed 's/^/- /' "$actual_sorted_file" >&2
  exit 1
fi
