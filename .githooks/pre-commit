#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

expected_branch="main"
current_branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$current_branch" != "$expected_branch" ]; then
  echo "dm_voicelint policy: commits are only allowed on $expected_branch (current: $current_branch)" >&2
  exit 1
fi

extra_branches="$(git for-each-ref --format='%(refname:short)' refs/heads | grep -v '^main$' || true)"
if [ -n "$extra_branches" ]; then
  echo "dm_voicelint policy: local side branches are not allowed:" >&2
  echo "$extra_branches" >&2
  exit 1
fi
